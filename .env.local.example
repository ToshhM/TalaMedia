# Copier ce fichier en .env.local — .env.local n'est JAMAIS versionne.

# Adresse publique du site, utilisee par le sitemap, les flux RSS et les
# images de partage. Sans protocole ni slash final.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity — a remplir quand le CMS sera cree.
# Tant que ces variables sont vides, le site tourne sur les donnees de
# demonstration de src/lib/sample-data.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_VERSION=2026-08-01

# Jeton de LECTURE SEULE, cote serveur uniquement. Ne jamais prefixer
# cette variable par NEXT_PUBLIC_ : elle partirait dans le navigateur.
SANITY_API_READ_TOKEN=

# Secret partage qui signe le webhook de revalidation. Sans lui,
# n'importe qui peut faire tomber le cache du site en boucle.
SANITY_REVALIDATE_SECRET=
